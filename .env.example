# ─── ERA5 / Copernicus CDS API ─────────────────────────────────────────────
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=your_cds_api_key_here

# ─── Open-Meteo (no key needed) ─────────────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# API endpoint for city geocoding (city → latitude/longitude)
GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search

# ─── Location — Azamgarh ────────────────────────────────────────────────────
LATITUDE=26.00
LONGITUDE=83.00
TIMEZONE=Asia/Kolkata

# ─── Paths ──────────────────────────────────────────────────────────────────
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODEL_XGBOOST_DIR=models/xgboost
MODEL_LSTM_DIR=models/lstm
SCALER_DIR=models/scalers

# ─── Model filenames ────────────────────────────────────────────────────────
XGBOOST_MODEL_FILE=rain_model.json
XGBOOST_META_FILE=xgb_model_meta.json
LSTM_MODEL_FILE=lstm_temp_model.keras
LSTM_META_FILE=lstm_model_meta.json
SCALER_FILE=lstm_temp_scaler.pkl

# ─── FastAPI app ────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=True
APP_PORT=8000

# ─── Forecast settings ──────────────────────────────────────────────────────
FORECAST_N=5
LOOKBACK=24
FORECAST_DAYS=5

# ─── MLflow (Tracking Experiment) ────────────────────────────────────────────
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=your_mlflow_username
MLFLOW_TRACKING_PASSWORD=your_mlflow_password